           print(f\'Port {port} TIMEOUT after cmd\')\n        \n        s.close()\n    except Exception as e:\n        print(f\'Port {port} error: {e}\')\n\nprint(\'=== Test: Wait for Password prompt after banner ===\')\ntry_with_telnet_negotiation(2601)\nprint()\ntry_with_telnet_negotiation(2602)\n"', 'description': 'Try more careful interaction with timeout to see full server response sequence', 'timeout': 60000}; start
