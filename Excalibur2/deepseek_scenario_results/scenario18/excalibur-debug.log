                   result += bytes([IAC])\n                    i += 2\n                    continue\n                else:\n                    i += 2\n                    continue\n        else:\n            result += bytes([data[i]])\n            i += 1\n    return result\n\ns = socket.socket()\ns.settimeout(5)\ns.connect((\'10.254.200.1\', 2601))\n\n# Wait for initial data\ntime.sleep(0.5)\ndata = read_available(s, 1)\nprint(f"Raw initial: {repr(data)}")\nclean = handle_telnet(data)\nprint(f"Clean initial: {repr(clean)}")\n\n# Respond to telnet negotiations if any\nfor cmd_byte, opt_byte in [(data[i+1], data[i+2]) for i in range(0, len(data)-2) if data[i] == IAC]:\n    if cmd_byte == WILL:\n        response = bytes([IAC, DONT, opt_byte])\n        print(f"Responding to WILL {opt_byte}: DONT")\n    elif cmd_byte == DO:\n        response = bytes([IAC, WONT, opt_byte])\n        print(f"Responding to DO {opt_byte}: WONT")\n    else:\n        continue\n    s.send(response)\n    time.sleep(0.1)\n\n# Now try sending password and commands\ns.send(b\'\\r\\n\')\ntime.sleep(0.3)\ndata = read_available(s, 1)\nclean = handle_telnet(data)\nprint(f"After password: raw={repr(data)} clean={repr(clean)}")\n\n# Handle any telnet negotiations in response\nfor cmd_byte, opt_byte in [(data[i+1], data[i+2]) for i in range(0, len(data)-2) if data[i] == IAC]:\n    if cmd_byte == WILL:\n        response = bytes([IAC, DONT, opt_byte])\n    elif cmd_byte == DO:\n        response = bytes([IAC, WONT, opt_byte])\n    else:\n        continue\n    s.send(response)\n    time.sleep(0.1)\n\n# Send enable\ns.send(b\'enable\\r\\n\')\ntime.sleep(0.3)\ndata = read_available(s, 1)\nclean = handle_telnet(data)\nprint(f"After enable: raw={repr(data)} clean={repr(clean)}")\n\n# Send commands\nfor cmd in [\'terminal length 0\', \'show version\', \'show running-config\', \'show ip route\', \'show interface\']:\n    s.send((cmd + \'\\r\\n\').encode())\n    time.sleep(0.3)\n    data = read_available(s, 1)\n    clean = handle_telnet(data)\n    print(f"After \'{cmd}\': raw={repr(data[:500])} clean={repr(clean[:500])}")\n\ns.close()\nPYEOF', 'description': 'Implement telnet negotiation for Quagga VTY', 'timeout': 30000}; start
