timeout(10)\ns.connect((\'10.254.200.1\', 2601))\nbanner = s.recv(4096)\nprint(f"Banner: {repr(banner)}")\n\n# Send password and wait\ns.send(b\'\\n\')\ntime.sleep(0.3)\n\n# Read response \ntry:\n    data = s.recv(4096)\n    print(f"After password: {repr(data)}")\nexcept socket.timeout:\n    print("Timeout - no prompt received")\n\n# Send command\ns.send(b\'enable\\n\')\ntime.sleep(0.3)\ntry:\n    data = s.recv(4096)\n    print(f"After enable: {repr(data)}")\nexcept socket.timeout:\n    print("Timeout after enable")\n\ns.send(b\'show ip route\\n\')\ntime.sleep(0.3)\ntry:\n    data = s.recv(4096)\n    print(f"After show ip route: {repr(data)}")\nexcept socket.timeout:\n    print("Timeout after show ip route")\n\ns.close()\n\n# Also check: maybe .10 is serving Unomi but the PORTS are only accessible \n# from specific source IPs (like the router\'s internal IP)\n# Let me try connecting THROUGH the router using source routing\n# (loose source routing with IP options)\n\nPYEOF', 'description': 'Try traceroute, TCP keepalive on vty, and source routing'}; start
