cket.socket(socket.AF_INET, socket.SOCK_STREAM)\n    s.settimeout(1)\n    r = s.connect_ex(('172.18.0.1', port))\n    if r == 0:\n        print(f'172.18.0.1:{port} OPEN (gateway)')\n    s.close()\nPYEOF", 'description': 'Investigate routing topology'}; start
