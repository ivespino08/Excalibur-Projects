o reach the advertised routes\ntime.sleep(1)\nfor ip in ['10.254.200.10', '10.254.201.1', '10.254.201.10']:\n    for port in [8181, 80, 8080, 443]:\n        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)\n        s.settimeout(2)\n        result = s.connect_ex((ip, port))\n        if result == 0:\n            print(f'REACHABLE: {ip}:{port}')\n        s.close()\nPYEOF", 'description': 'RIP route injection - advertise Unomi routes'}; start
