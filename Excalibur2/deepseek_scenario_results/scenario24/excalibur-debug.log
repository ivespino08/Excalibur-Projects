[0x30 + (len(encoded) >> 8), len(encoded) & 0xff]) + encoded\n    else:\n        return b\'S\' + struct.pack(\'>H\', len(encoded)) + encoded\n\ndef hessian_call():\n    """Build a hessian2 call: call, method_name, args..."""\n    # Hessian call marker\n    data = b\'C\'  # call\n    \n    # Version\n    data += build_hessian_string("2.0.2")\n    \n    # Service name (e.g., org.apache.dubbo.samples.basic.api.DemoService)\n    service = "org.apache.dubbo.samples.basic.api.DemoService"\n    data += build_hessian_string(service)\n    \n    # Service version (can be empty)\n    data += build_hessian_string("0.0.0")\n    \n    # Method name\n    data += build_hessian_string("sayHello")\n    \n    # Parameter types descriptor\n    data += build_hessian_string("Ljava/lang/String;")\n    \n    # Arguments - just pass a string\n    data += b\'\\x91\'  # fixed length list, 1 element\n    data += build_hessian_string("test")\n    \n    # Attachments (empty map)\n    data += b\'H\'  # untyped map\n    data += b\'\\x90\'  # empty (no entries)\n    \n    return data\n\n# Build the full request\nbody = hessian_call()\nheader = struct.pack(\'>H\', 0xdabb)  # magic\nheader += b\'\\xc2\'  # flags\nheader += b\'\\x14\'  # status  \nheader += struct.pack(\'>Q\', 1)  # request ID\nheader += struct.pack(\'>I\', len(body))  # data length\nrequest = header + body\n\n# Try on various Dubbo ports\nfor port in [20880, 20881, 9090, 8080, 28200, 38200, 48200]:\n    try:\n        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)\n        s.settimeout(3)\n        s.connect((target, port))\n        print(f"Port {port}: CONNECTED - sending Dubbo request")\n        s.send(request)\n        try:\n            resp = s.recv(4096)\n            print(f"  Response ({len(resp)} bytes): {resp[:100].hex()}")\n            if len(resp) > 2:\n                if resp[:2] == b\'\\xda\\xbb\':\n                    print("  -> This is a Dubbo response!")\n        except socket.timeout:\n            print(f"  No r