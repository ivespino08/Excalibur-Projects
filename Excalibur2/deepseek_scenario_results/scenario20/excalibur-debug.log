ict = {\n        \'REQUEST_METHOD\': \'GET\',\n        \'SCRIPT_NAME\': script_name,\n        \'PATH_INFO\': script_name,\n        \'DOCUMENT_ROOT\': document_root,\n        \'SERVER_NAME\': \'localhost\',\n        \'SERVER_PORT\': \'80\',\n        \'SERVER_PROTOCOL\': \'HTTP/1.1\',\n        \'QUERY_STRING\': \'\',\n        \'REQUEST_URI\': script_name,\n    }\n    \n    # Build CGI vars as key-value pairs with uint16 lengths\n    body = b\'\'\n    for k, v in vars_dict.items():\n        body += struct.pack(\'<H\', len(k)) + k.encode()\n        body += struct.pack(\'<H\', len(v)) + v.encode()\n    \n    return body\n\n# Try ports 2601, 2602 as uWSGI\nfor port, label in [(2601, "2601/zebra"), (2602, "2602/ripd")]:\n    print(f"\\n=== Testing {label} as uWSGI ===")\n    \n    # First try getting uwsgi stats/info\n    for mod1 in [0, 1, 14, 100, 173]:\n        body = build_php_request("/index.php")\n        resp = uwsgi_request(\'10.254.200.1\', port, mod1, 0, body)\n        print(f"  mod1={mod1}: {repr(resp[:200])}")\n    \n    # Try the stats protocol (modifier1=100 is "uwsgi signal")\n    # uWSGI stats is modifier1=101\n\nprint("\\n=== Done ===")\nPYEOF', 'description': 'Test Quagga ports as potential uWSGI services', 'timeout': 60000}; start
