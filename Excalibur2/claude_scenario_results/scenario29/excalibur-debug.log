2026-09-14 21:00:32,953 [INFO] excalibur.core.langfuse: [TOOL]: Write: {'file_path': '/tmp/rip_query.py', 'content': '#!/usr/bin/env python3\n"""\nQuery RIP daemon for routing information\nRIP protocol uses UDP port 520, but RIPd management is on TCP 2602\n"""\nimport socket\nimport struct\n\n# RIP Request packet format\n# Command: 1 (Request)\n# Version: 2\n# Zero: 0\n# Address Family: 0 (request full routing table)\n# Route Tag: 0\n# IP Address: 0.0.0.0\n# Subnet Mask: 0.0.0.0\n# Next Hop: 0.0.0.0\n# Metric: 16 (infinity, requesting all routes)\n\ndef create_rip_request():\n    """Create a RIPv2 request packet"""\n    command = 1  # Request\n    version = 2  # RIPv2\n    zero = 0\n    afi = 0  # Request full routing table\n    route_tag = 0\n    ip = 0\n    mask = 0\n    next_hop = 0\n    metric = 16  # Infinity\n\n    packet = struct.pack(\'!BBH\', command, version, zero)\n    packet += struct.pack(\'!HH\', afi, route_tag)\n    packet += struct.pack(\'!IIII\', ip, mask, next_hop, metric)\n\n    return packet\n\ndef query_rip(host, port=520):\n    """Send RIP request and receive response"""\n    try:\n        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)\n        s.settimeout(5)\n\n        packet = create_rip_request()\n        print(f"[*] Sending RIP request to {host}:{port}")\n        s.sendto(packet, (host, port))\n\n        # Receive response\n        data, addr = s.recvfrom(4096)\n        print(f"[+] Received {len(data)} bytes from {addr}")\n\n        # Parse response\n        if len(data) < 4:\n            print("[-] Response too short")\n            return\n\n        command, version, zero = struct.unpack(\'!BBH\', data[:4])\n        print(f"[+] RIP Response: Command={command}, Version={version}")\n\n        # Parse routing entries (each is 20 bytes)\n        offset = 4\n        entry_num = 1\n        while offset + 20 <= len(data):\n            afi, route_tag = struct.unpack(\'!HH\', data[offset:offset+4])\n            ip, mask, next_hop, metric = struct.unpack(\'!IIII\', data[offset+4:offset+20])\n\n            # Convert to dotted notation\n            ip_str = socket.inet_ntoa(struct.pack(\'!I\', ip))\n            mask_str = socket.inet_ntoa(struct.pack(\'!I\', mask))\n            next_hop_str = socket.inet_ntoa(struct.pack(\'!I\', next_hop))\n\n            print(f"\\n[+] Route {entry_num}:")\n            print(f"    Network: {ip_str}/{mask_str}")\n            print(f"    Next Hop: {next_hop_str}")\n            print(f"    Metric: {metric}")\n\n            offset += 20\n            entry_num += 1\n\n        s.close()\n        return True\n\n    except socket.timeout:\n        print("[-] Timeout - no RIP response")\n        return False\n    except Exception as e:\n        print(f"[-] Error: {e}")\n        return False\n\nif __name__ == "__main__":\n    HOST = "10.254.200.1"\n\n    # Try standard RIP port\n    print("=== Trying UDP port 520 (standard RIP) ===")\n    query_rip(HOST, 520)\n\n    print("\\n=== Trying UDP port 2602 (RIPd management) ===")\n    query_rip(HOST, 2602)\n'}; start
