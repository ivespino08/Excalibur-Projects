metric))\n\nif not routes:\n    print("No usable RIPv2 routes parsed")\nelse:\n    print("Parsed routes:")\n    for r in routes:\n        print(" ", r[0], r[1], "nexthop", r[2], "metric", r[3])\nPY\n\n# Show raw hex as fallback\necho "--- Raw RIP hex saved at $OUT/resp.hex ---"; head -c 200 "$OUT/resp.hex"; echo\n\'', 'description': 'Send a crafted RIPv2 full table request to 10.254.200.1:520 via UDP and parse any response to enumerate routed subnets', 'timeout': 120000, 'run_in_background': False, 'dangerouslyDisableSandbox': False}; start
