 time.sleep(0.3)\n    # read some output\n    idx,buf=read_until_any(tn,[b"#",b">"],timeout=3)\n    print(buf.decode(errors=\'ignore\'))\n\ntry:\n    tn.write(b"exit\\r\\n")\n    tn.close()\nexcept Exception:\n    pass\nPY', 'description': 'Attempt automated telnet login to Quagga zebra vty on 10.254.200.1:2601 using common defaults and dump routing/config info', 'timeout': 120000, 'run_in_background': False, 'dangerouslyDisableSandbox': False}; start
